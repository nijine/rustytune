[Unit]
Description=RustyTune Speeduino appliance
After=network-online.target
Wants=network-online.target rustytune-poweroff.path
Conflicts=speeduino-logger.service speeduino-dash.service

[Service]
Type=simple
User=rustytune
Group=rustytune
SupplementaryGroups=dialout
ExecStart=/usr/local/bin/rustytune --profile appliance --config /etc/rustytune/rustytune.toml
Restart=on-failure
RestartSec=3
RuntimeDirectory=rustytune
StateDirectory=rustytune
LogsDirectory=speeduino
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/speeduino /var/lib/rustytune /run/rustytune
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
